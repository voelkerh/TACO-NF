// nextflow.config

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.cacheDir = "/var/tmp/projekt/singularity_containers/"
    singularity.envWhitelist = "no_proxy,ftp_proxy,https_proxy,http_proxy,all_proxy,rsync_proxy"
    docker.enabled = false
    podman.enabled = false
    shifter.enabled = false
    charliecloud.enabled = false
  }
}


