Bootstrap: localimage
From: python3.11_base.sif

%post
    # Install Python packages
    pip install --no-cache-dir \
        pandas \
        dash \
        numpy \
        plotly \
        ete3 \
        toytree \
        nextflow \
    wget https://files.pythonhosted.org/packages/96/26/e67015926da9e28018c1bff42b2fdbc8d4eeb275dc30d21057a5504d03de/phylotree-0.1.1-cp311-cp311-manylinux_2_28_x86_64.whl
    pip install ./phylotree-0.1.1-cp311-cp311-manylinux_2_28_x86_64.whl

%files
    /home/davidkirchner/code/htwpipe/nextflow/appcontainer/pythonfiles /opt/pythonfiles

%environment
    export PATH=$PATH:/usr/local/bin
    export PYTHONPATH=$PYTHONPATH:/opt/pythonfiles


%runscript
    # This will be the default command when the container is run
    exec python3 "$@"

